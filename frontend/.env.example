# Your Railway backend URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Google sign-in (Firebase console → Project settings → General → Your apps → Web app config)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Google's official sign-in button (recommended). Same OAuth client as Firebase:
# Google Cloud → APIs & Services → Credentials → 'Web client (auto created by Google Service)' → Client ID
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
