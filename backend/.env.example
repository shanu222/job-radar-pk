# ── Required ────────────────────────────────────────────────
# On Railway: add a PostgreSQL service and reference it: DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jobradar
JWT_SECRET=generate-a-long-random-string
# Your Vercel URL(s), comma separated
FRONTEND_URL=http://localhost:3000
# Lets scripts call /api/admin/* with an x-admin-key header (the admin panel uses your admin login instead)
ADMIN_KEY=another-long-random-string

# ── Admin account (created/promoted on startup; password re-applied only when this value changes) ──
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Payment notifications go here (can also be changed in Admin → Settings → Email)
ADMIN_NOTIFY_EMAIL=

# ── Google sign-in (Firebase) — only the project ID is needed on the server ──
FIREBASE_PROJECT_ID=

# ── Email via Resend (or set it in Admin → Settings → Email) ──
RESEND_API_KEY=
MAIL_FROM=JobRadar PK <onboarding@resend.dev>

# ── Recommended job sources ────────────────────────────────
# Google Jobs via JSearch (LinkedIn, Indeed, Rozee, Glassdoor…). Searches are built automatically
# from each user's CV (job titles × preferred locations, + remote if wanted) — no fixed list.
RAPIDAPI_KEY=
# Hard cap on credits per calendar month (1 credit = 1 page of ≤10 results). ~180 fits the free plan.
JSEARCH_MONTHLY_CREDITS=180
# Max searches per scheduled run, and how long before the same search may run again
JSEARCH_MAX_QUERIES=6
JSEARCH_MIN_HOURS=24
JSEARCH_PAGES=1
# Searches run immediately for a user after they upload a CV or edit their titles/locations
JSEARCH_PER_USER_QUERIES=2
# Optional, only used while no user has a CV yet, e.g. "software engineer in Islamabad|remote developer"
JSEARCH_FALLBACK_QUERIES=
# UN / NGO jobs with real closing dates (free, request an appname from ReliefWeb)
RELIEFWEB_APPNAME=
RELIEFWEB_INCLUDE_HOMEBASED=true
# Reddit official API (create a "script" app at reddit.com/prefs/apps)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_SUBREDDITS=forhire,hiring,remotejs,jobbit,freelance_forhire,PakistanJobs,pakistan,Islamabad,karachi,lahore
# Extra RSS feeds: label|url|category|country;label2|url2|...
RSS_FEEDS=
# Comma list of source names to switch off: pkgov,jsearch,reliefweb,remotive,remoteok,arbeitnow,jobicy,himalayas,rss,reddit
DISABLED_SOURCES=
# Limit Pakistani govt scraping to some sites (ids from src/sources/pk-sites.json)
PK_SITES=

# ── Email via SMTP instead of Resend (optional) ─────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
REMINDER_DAYS_AHEAD=3

# ── Optional ───────────────────────────────────────────────
# AI keys are normally set in Admin → Settings → AI. These are fallbacks.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Cron (UTC). 0 4 * * * = 9:00 AM Pakistan time
INGEST_CRON=0 */3 * * *
REMINDER_CRON=0 4 * * *
RUN_INGEST_ON_BOOT=true
ALLOW_VERCEL_PREVIEWS=false
